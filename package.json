{
  "name": "noder",
  "version": "0.7.1",
  "description": "Noder - Real-time collaborative code editor and app builder by JagX and JRILICENSE",
  "main": "dist-electron/main.js",
  "author": "JagX & JRILICENSE",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "generate:icons": "python3 scripts/generate-icons.py || python scripts/generate-icons.py",
    "build": "npm run generate:icons && vite build && electron-builder --publish never",
    "build:win": "npm run generate:icons && vite build && electron-builder --win --publish never",
    "build:mac": "npm run generate:icons && vite build && electron-builder --mac --publish never",
    "build:linux": "npm run generate:icons && vite build && electron-builder --linux --publish never",
    "build:all": "npm run generate:icons && vite build && electron-builder -mwl --publish never",
    "build:dir": "npm run generate:icons && vite build && electron-builder --dir",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "collab:server": "node collab-server/server.js",
    "postinstall": "node -e \"try{require('child_process').execSync('electron-builder install-app-deps',{stdio:'inherit'})}catch(e){console.warn('[noder] native rebuild skipped (optional)')}\"",
    "rebuild": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.460.0",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git": "^3.27.0",
    "uuid": "^11.0.3",
    "ws": "^8.18.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "y-monaco": "^0.1.5",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.18"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.jagx.noder",
    "productName": "Noder",
    "copyright": "Copyright © 2026 JagX & JRILICENSE",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "extensions/**/*",
      "collab-server/**/*",
      "marketplace/**/*",
      "templates/**/*",
      "assets/logo.svg",
      "assets/wordmark.svg"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "asarUnpack": [
      "**/node_modules/node-pty/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "JagX-JRILICENSE",
        "repo": "Noder"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "JagX & JRILICENSE",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Noder",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
