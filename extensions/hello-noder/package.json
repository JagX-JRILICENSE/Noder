{
  "name": "hello-noder",
  "displayName": "Hello Noder",
  "version": "0.2.0",
  "description": "Sample extension demonstrating commands, status bar, and the Noder extension API.",
  "publisher": "JagX-JRILICENSE",
  "engines": {
    "noder": "^0.4.0"
  },
  "categories": ["Other"],
  "activationEvents": ["*"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hello-noder.sayHello",
        "title": "Say Hello",
        "category": "Hello Noder"
      },
      {
        "command": "hello-noder.showWorkspace",
        "title": "Show Workspace Path",
        "category": "Hello Noder"
      }
    ],
    "statusBar": [
      {
        "id": "hello-noder.status",
        "text": "$(smile) Hello",
        "command": "hello-noder.sayHello"
      }
    ]
  }
}
